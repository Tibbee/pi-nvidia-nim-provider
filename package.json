    "scripts": {
        "test": "npx --yes tsx test/refactor-checks.ts && npx --yes tsx test/before-provider-request-snapshots.ts && npx --yes tsx test/pi-provider-comparison.ts && npx --yes tsx test/image-generation-tests.ts && npx --yes tsx test/image-hardening-tests.ts && npx --yes tsx test/image-probe-tests.ts && npx --yes tsx test/image-aspect-edit-tests.ts && npx --yes tsx test/image-preset-tests.ts && npx --yes tsx test/image-grid-tests.ts",
        "test:pi-images": "npx --yes tsx test/pi-image-runtime-tests.ts",
        "probe:images": "npx --yes tsx tools/probe_nim_images.ts",
        "probe": "npx --yes tsx tools/probe_nim.ts",
        "compare:pi": "npx --yes tsx tools/compare_pi_nvidia.ts"
